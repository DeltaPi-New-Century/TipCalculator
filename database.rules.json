{
  "rules": {
    "sessions": {
      "$code": {
        ".read": "auth != null && (!data.exists() || data.child('expiresAt').val() > now)",
        ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['status','ownerUid','createdAt','expiresAt','currency'])",
        "status": {
          ".validate": "newData.val() === 'open' || newData.val() === 'closed'"
        },
        "ownerUid": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 90000000"
        },
        "currency": {
          ".validate": "newData.isString() && newData.val().length <= 4"
        },
        "tipPercent": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "members": {
          "$uid": {
            ".write": "auth.uid === $uid && root.child('sessions/' + $code + '/status').val() === 'open'",
            ".validate": "newData.hasChildren(['name','joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "items": {
          "$item": {
            ".write": "auth != null && root.child('sessions/' + $code + '/status').val() === 'open' && (!data.exists() || data.child('uid').val() === auth.uid) && (!newData.exists() || newData.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid','label','price'])",
            "uid": {
              ".validate": "(newData.val() === auth.uid || root.child('sessions/' + $code + '/ownerUid').val() === auth.uid) && root.child('sessions/' + $code + '/members/' + newData.val()).exists()"
            },
            "label": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "price": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
